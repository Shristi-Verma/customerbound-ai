# ---------------------------------------------------------------------------
# HXL (Headless Experience Layer) - Track B
#
# This project holds NO Salesforce credentials of its own and never calls
# Salesforce directly. It signs in through the Track A Headless Identity BFF as
# a named customer, which is the whole point: the agent surface gets a
# customer's view, not an integration user's.
# ---------------------------------------------------------------------------

# Where the Track A BFF is listening (../hxl-demo, `npm start`).
HXL_BFF_URL=http://localhost:3000

# The demo community user the MCP server signs in as. Without these the widget
# still renders, clearly labelled as sample data.
HXL_DEMO_USER=ada.hxl@hxlpoc.demo
HXL_DEMO_PASSWORD=

# --- Hosted transport (mcp/server-http.mjs), for ChatGPT and Slackbot ---
# Port the Streamable HTTP server listens on. Expose it with cloudflared/ngrok.
HXL_MCP_PORT=8787
# Over HTTP, sessions must call sign_in. Set to 1 ONLY for a throwaway tunnel
# demo where every unsigned session may act as HXL_DEMO_USER.
HXL_ALLOW_ENV_IDENTITY=0
