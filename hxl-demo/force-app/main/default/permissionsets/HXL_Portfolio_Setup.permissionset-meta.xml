<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>HXL Portfolio Setup</label>
    <description>Administrative field access used to assign POC records to the controlled staff portfolio. Does not grant the staff custom permission.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>HXL_Order__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>HXL_Action_Event__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>HXL_Order__c.Staff_Visible__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions><field>HXL_Order__c.Customer_Message__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>HXL_Order__c.Requires_Supervisor__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>HXL_Order__c.Supervisor_Approved__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>HXL_Action_Event__c.Actor_User__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>HXL_Action_Event__c.Channel__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>HXL_Action_Event__c.Customer_Contact__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>HXL_Action_Event__c.From_Status__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>HXL_Action_Event__c.Note__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>HXL_Action_Event__c.To_Status__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
</PermissionSet>
