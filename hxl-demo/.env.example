# ---------------------------------------------------------------------------
# HXL demo - Headless Experience Layer
# Copy to .env and fill in after you have authenticated your org and created
# the Experience Cloud site + connected app (see README "Org setup").
# ---------------------------------------------------------------------------

# Experience Cloud site base URL. This is the HXL auth + data host.
# NOT your my.salesforce.com login URL - headless identity only works against
# the site domain.
#   e.g. https://mydomain.my.site.com/hxlstore
SF_SITE_URL=https://YOURDOMAIN.my.site.com/hxlstore

# Connected app (External Client App) credentials.
# Consumer key is safe to expose to the browser; the secret is NOT and stays
# on the BFF only. This demo runs as a *private* client: the browser never
# sees the secret and never talks to Salesforce directly.
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Must match a callback URL registered on the connected app exactly.
SF_REDIRECT_URI=http://localhost:3000/callback

# Scopes requested by the headless flows.
SF_SCOPES=api refresh_token openid

# Comma-separated list of headless init endpoints that have "Require
# authentication to access this API" ticked on the site. The BFF then fetches a
# client-credentials token and sends it as a bearer on those calls only - a
# bearer sent to an endpoint that is NOT expecting one is rejected as an
# authentication failure. Valid values: registration, passwordless,
# forgot_password. Requires the connected app to have the client credentials
# flow enabled with a Run As user.
SF_INIT_AUTH_FLOWS=

# Local BFF port
PORT=3000

# Set to 1 to log full Salesforce request/response bodies to the console.
# Handy on stage, never in a real deployment.
HXL_DEBUG=1
