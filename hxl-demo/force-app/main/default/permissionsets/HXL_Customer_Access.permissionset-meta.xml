<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>HXL Customer Access</label>
    <description>Grants Experience Cloud customer users access to the HXL order data endpoint. Assign to the site's authenticated user profile.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>HXL_OrderAPI</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <object>HXL_Order__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>HXL_Order__c.Total_Amount__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>HXL_Order__c.Placed_On__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>HXL_Order__c.Channel__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>HXL_Order__c.Owner_Contact__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions><field>HXL_Order__c.Customer_Message__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <userPermissions>
        <name>ApiEnabled</name>
        <enabled>true</enabled>
    </userPermissions>
</PermissionSet>
